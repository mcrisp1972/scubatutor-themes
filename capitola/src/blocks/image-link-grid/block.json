{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/image-link-grid",
	"title": "Image Link Grid",
	"textdomain": "capitola",
	"description": "Display a grid layout of linked image cards within the Image Link Grid Block.",
	"category": "custom-blocks",
	"keywords": [
		"image links",
		"grid",
		"cards",
		"gallery"
	],
	"supports": {
		"html": false,
		"customCSS": false,
		"lock": false
	},
	"parent": [
		"capitola/image-link-grid-block"
	],
	"allowedBlocks": [
		"capitola/image-link-grid-item"
	],
	"usesContext": [
		"capitola/gridLayout",
		"capitola/gridGap",
		"capitola/excerptLines"
	],
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}