{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/image-link-grid",
	"title": "Image Link Grid",
	"textdomain": "capitola",
	"description": "Display a grid layout of linked image cards within the Image Link Grid Block.",
	"category": "custom-blocks",
	"keywords": [
		"image links",
		"grid",
		"cards",
		"gallery"
	],
	"supports": {
		"html": false,
		"customCSS": false,
		"lock": false
	},
	"attributes": {
		"titleTag": {
			"type": "string",
			"default": "h3"
		},
		"gridLayout": {
			"type": "string",
			"default": "3-col"
		},
		"gridGap": {
			"type": "boolean",
			"default": true
		},
		"excerptLines": {
			"type": "integer",
			"default": 4
		}
	},
	"parent": [
		"capitola/image-link-grid-block"
	],
	"allowedBlocks": [
		"capitola/image-link-grid-item"
	],
	"providesContext": {
		"capitola/titleTag": "titleTag"
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}