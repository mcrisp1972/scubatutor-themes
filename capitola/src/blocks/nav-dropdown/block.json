{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/nav-dropdown",
	"title": "Nav Dropdown",
	"textdomain": "capitola",
	"description": "Add a dropdown navigation group with manual or auto-populated links.",
	"category": "nav-blocks",
	"keywords": [
		"dropdown",
		"header",
		"navigation",
		"menu"
	],
	"parent": [
		"capitola/nav"
	],
	"supports": {
		"html": false
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"link": {
			"type": "object",
			"default": {}
		},
		"alignment": {
			"type": "string",
			"default": "--right-align"
		},
		"populationMethod": {
			"type": "string",
			"default": "manual"
		},
		"autoPopulatePostType": {
			"type": "string",
			"default": "page"
		},
		"columns": {
			"type": "integer",
			"default": 1
		}
	},
	"style": "capitola-nav-dropdown",
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}