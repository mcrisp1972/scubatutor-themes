{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/form-block",
	"title": "Form Block",
	"textdomain": "capitola",
	"description": "Pair introductory content with an embedded form in a two-column layout.",
	"category": "custom-blocks",
	"keywords": [
		"form",
		"contact form",
		"lead form",
		"two column"
	],
	"supports": {
		"anchor": true,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			],
			"padding": [
				"top",
				"bottom"
			]
		},
		"html": false
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"colorTheme": {
			"type": "string",
			"default": false
		},
		"revealAnimation": {
			"type": "object",
			"default": {
				"animation": "",
				"section": "block"
			}
		},
		"introAlign": {
			"type": "string",
			"default": "left"
		}
	},
	"example": {
		"innerBlocks": [
			{
				"name": "capitola/body-text",
				"attributes": {
					"eyebrow": "Cupidatat pariatur",
					"headline": "Nulla Minim Est Do",
					"cta": {
						"title": "Consequat",
						"link": {
							"url": "/"
						}
					},
					"cta2": {
						"title": "Velit amet",
						"link": {
							"url": "/"
						}
					}
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Veniam do ex ex est elit culpa consequat excepteur occaecat quis. Nostrud magna ullamco exercitation nisi aliqua labore magna eiusmod mollit dolor aute non consequat."
						}
					}
				]
			},
			{
				"name": "capitola/inner-block-wrap",
				"attributes": {
					"className": "wp-block-capitola-form-block__form-col capitola-form"
				},
				"innerBlocks": [
					{
						"name": "capitola/dummy-form"
					}
				]
			}
		],
		"viewportWidth": 1440
	},
	"providesContext": {
		"revealAnimation": "revealAnimation",
		"introAlign": "introAlign"
	},
	"viewScript": "capitola-animations",
	"render": "file:./render.php",
	"style": [
		"capitola-form-block",
		"capitola-wp-forms",
		"capitola-GForm"
	],
	"editorScript": "file:./index.js"
}