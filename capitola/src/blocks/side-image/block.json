{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/side-image",
	"title": "Side Image",
	"description": "",
	"category": "custom-blocks",
	"keywords": ["links"],
	"supports": {
		"anchor": true,
		"spacing": {
			"margin": ["top", "bottom"],
			"padding": ["top", "bottom"]
		}
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"introAlign": {
			"type": "string",
			"default": "left"
		},
		"imageLayout": {
			"type": "string",
			"default": "inner"
		},
		"imageParallax": {
			"type": "boolean",
			"default": false
		},
		"allowImageLayout": {
			"type": "boolean",
			"default": true
		},
		"mediaType": {
			"type": "string",
			"default": "image"
		},
		"stickyImage": {
			"type": "boolean",
			"default": false
		},
		"externalImage": {
			"type": "boolean",
			"default": false
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"videoUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"sideImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"imageCropPosition": {
			"type": "string",
			"default": "center center"
		},
		"iframeCode": {
			"type": "string",
			"default": ""
		},
		"imageRatio": {
			"type": "string",
			"default": "16-9"
		},
		"imageRadius": {
			"type": "string",
			"default": "small"
		},
		"showCaption": {
			"type": "boolean",
			"default": false
		},
		"imageCaption": {
			"type": "string",
			"default": ""
		},
		"verticalAlign": {
			"type": "string",
			"default": "center"
		},
		"videoSource": {
			"type": "string",
			"default": "youtube"
		},
		"videoObject": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"videoID": {
			"type": "string",
			"default": ""
		},
		"colorTheme": {
			"type": "string",
			"default": false
		},
		"revealAnimation": {
			"type": "string",
			"default": "0"
		},
		"revealSection": {
			"type": "string",
			"default": "body"
		},
		"allowRevealSectionSelect": {
			"type": "boolean",
			"default": true
		},
		"isVideoVariation": {
			"type": "boolean",
			"default": false
		},
		"isHeroVariation": {
			"type": "boolean",
			"default": false
		},
		"isIframeVariation": {
			"type": "boolean",
			"default": false
		},
		"bodyTextOptions": {
			"type": "object",
			"default": {
				"disableBackgroundImage": true,
				"disableVerticalAlign": true
			}
		}
	},
	"example": {
		"attributes": {
			"sideImage": {
				"source_url": "https://pd.w.org/2023/05/8616454d45ef02002.62343426-1536x1152.jpeg"
			},
			"imageLayout": "full",
			"videoSource": "youtube",
			"videoID": "K3106WtK-zg"
		},
		"innerBlocks": [
			{
				"name": "capitola/body-text",
				"attributes": {
					"eyebrow": "Cupidatat pariatur",
					"headline": "Nulla Minim Est Do",
					"cta": {
						"title": "Consequat",
						"link": { "url": "/" }
					},
					"cta2": {
						"title": "Velit amet",
						"link": { "url": "/" }
					}
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Veniam do ex ex est elit culpa consequat excepteur occaecat quis. Nostrud magna ullamco exercitation nisi aliqua labore magna eiusmod mollit dolor aute non consequat."
						}
					}
				]
			}
		],
		"viewportWidth": 1440
	},
	"variations": [
		{
			"name": "side-video-cta",
			"title": "Side Video",
			"attributes": {
				"imageLayout": "inner",
				"mediaType": "video",
				"allowImageLayout": false,
				"videoSource": "youtube",
				"isVideoVariation": true
			},
			"isActive": ["isVideoVariation"]
		},
		{
			"name": "side-iframe-cta",
			"title": "Side iFrame",
			"attributes": {
				"imageLayout": "inner",
				"mediaType": "iframe",
				"allowImageLayout": false,
				"isIframeVariation": true
			},
			"isActive": ["isIframeVariation"]
		},
		{
			"name": "side-image-hero",
			"title": "Side Image Hero",
			"category": "hero-blocks",
			"attributes": {
				"imageLayout": "full",
				"headlineTag": "h1",
				"isHeroVariation": true
			},
			"isActive": ["isHeroVariation"]
		}
	],
	"providesContext": {
		"bodyTextOptions": "bodyTextOptions",
		"revealAnimation": "revealAnimation",
		"revealSection": "revealSection",
		"introAlign": "introAlign"
	},
	"viewScript": "capitola-animations",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "capitola-side-image",
	"editorStyle": "capitola-side-image-editor"
}
