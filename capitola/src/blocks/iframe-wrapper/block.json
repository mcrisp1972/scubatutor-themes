{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/iframe-wrapper",
	"title": "iFrame Wrapper",
	"textdomain": "capitola",
	"description": "Embed iframe content with controlled aspect ratio and responsive sizing.",
	"category": "custom-blocks",
	"keywords": [
		"iframe",
		"embed",
		"video",
		"map"
	],
	"supports": {
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		},
		"html": false,
		"customCSS": false
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": ""
		},
		"aspectRatio": {
			"type": "string",
			"default": "16-9"
		},
		"iframeHtml": {
			"type": "string",
			"default": ""
		}
	},
	"example": {},
	"render": "file:./render.php",
	"style": "capitola-iframe-wrapper",
	"editorStyle": "capitola-iframe-wrapper-editor",
	"editorScript": "file:./index.js"
}