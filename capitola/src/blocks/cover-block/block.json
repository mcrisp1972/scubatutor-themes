{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/cover-block",
	"title": "Cover Block",
	"textdomain": "capitola",
	"description": "Show headline, copy, and calls to action over a full-width background image.",
	"category": "custom-blocks",
	"keywords": [
		"cover",
		"hero",
		"banner",
		"background image"
	],
	"supports": {
		"anchor": true,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		},
		"html": false,
		"customCSS": false
	},
	"attributes": {
		"backgroundImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"imageOpacity": {
			"type": "number",
			"default": 0.5
		},
		"imageFocalPoint": {
			"type": "string",
			"default": "50% 50%"
		},
		"imageScrollAnimation": {
			"type": "string",
			"default": ""
		},
		"introAlign": {
			"type": "string",
			"default": "center"
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"eyebrowTag": {
			"type": "string",
			"default": "div"
		},
		"headline": {
			"type": "string",
			"default": ""
		},
		"headlineTag": {
			"type": "string",
			"default": "h2"
		},
		"cta": {
			"type": "object",
			"default": {}
		},
		"cta2": {
			"type": "object",
			"default": {}
		},
		"isHeroVariation": {
			"type": "boolean",
			"default": false
		}
	},
	"variations": [
		{
			"name": "background-image-hero",
			"title": "Background Image Hero",
			"category": "hero-blocks",
			"attributes": {
				"isHeroVariation": true,
				"headlineTag": "h1"
			},
			"isActive": [
				"isHeroVariation"
			]
		}
	],
	"example": {
		"attributes": {
			"backgroundImage": {
				"source_url": "https://pd.w.org/2022/11/471636e75a59f2df1.27699711-2048x1536.jpg"
			},
			"eyebrow": "Aute culpa",
			"headline": "Et exercitation officia",
			"cta": {
				"title": "Pariatur",
				"link": {
					"url": "/"
				}
			},
			"cta2": {
				"title": "Dolor dolor",
				"link": {
					"url": "/"
				}
			}
		},
		"innerBlocks": [
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Anim occaecat consectetur consectetur laborum consequat voluptate aute fugiat et minim non commodo est. Id irure veniam ad cillum tempor. Id amet cupidatat culpa elit cillum laborum tempor eiusmod pariatur quis dolore magna. Non ad nisi dolor duis deserunt."
				}
			}
		],
		"viewportWidth": 1440
	},
	"viewScript": "capitola-animations",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "capitola-cover-block"
}