{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/search-listings",
	"title": "Search Listings",
	"description": "",
	"category": "listing-blocks",
	"keywords": [],
	"supports": {
		"multiple": false
	},
	"attributes": {
		"colorTheme": {
			"type": "string",
			"default": false
		},
		"revealAnimation": {
			"type": "string",
			"default": "0"
		},
		"revealSection": {
			"type": "string",
			"default": "body"
		},
		"allowRevealSectionSelect": {
			"type": "boolean",
			"default": false
		},
		"listLayout": {
			"type": "string",
			"default": "card"
		},
		"orderBy": {
			"type": "string",
			"default": "id"
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"orderingOptions": {
			"type": "object",
			"default": false
		},
		"headline": {
			"type": "string",
			"default": ""
		},
		"headlineTag": {
			"type": "string",
			"default": "h2"
		},
		"titleTag": {
			"type": "string",
			"default": "h3"
		},
		"titleLocation": {
			"type": "string",
			"default": "image"
		},
		"ctaText": {
			"type": "string",
			"default": ""
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"excerptLines": {
			"type": "integer",
			"default": 4
		},
		"limit": {
			"type": "integer",
			"default": 12
		}
	},
	"example": {
		"viewportWidth": 1440
	},
	"render": "file:./render.php",
	"style": [
		"capitola-post-listing",
		"capitola-page-navigation"
	],
	"editorScript": "file:./index.js"
}