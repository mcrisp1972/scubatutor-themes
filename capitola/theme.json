					"background": "transparent",
					"padding": "var(--capitola-spacing-xxsmall) var(--capitola-spacing-xsmall)",
					"lineHeight": "1.5",
					"transition": "box-shadow 0.2s ease-in",
					"focusShadowSize": "0 0 0 1px",
					"focusShadowColor": "var(--capitola-color-body)"
