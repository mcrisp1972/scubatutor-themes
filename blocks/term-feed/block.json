{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "capitola/term-feed",
  "title": "Term Feed",
  "textdomain": "capitola",
  "description": "Display taxonomy terms in list, grid, or slider layouts.",
  "category": "listing-blocks",
  "keywords": [
    "terms",
    "taxonomy",
    "categories",
    "listing"
  ],
  "supports": {
    "anchor": true,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": [
        "top",
        "bottom"
      ]
    }
  },
  "attributes": {
    "anchor": {
      "type": "string",
      "default": ""
    },
    "colorTheme": {
      "type": "string",
      "default": false
    },
    "revealAnimation": {
      "type": "string",
      "default": "0"
    },
    "revealSection": {
      "type": "string",
      "default": "body"
    },
    "allowRevealSectionSelect": {
      "type": "boolean",
      "default": true
    },
    "listLayout": {
      "type": "string",
      "default": "card"
    },
    "showSlideCount": {
      "type": "boolean",
      "default": true
    },
    "orderBy": {
      "type": "string",
      "default": "name"
    },
    "introAlign": {
      "type": "string",
      "default": "top"
    },
    "titleTag": {
      "type": "string",
      "default": "h3"
    },
    "ctaText": {
      "type": "string",
      "default": "Read More"
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "excerptLines": {
      "type": "integer",
      "default": 4
    },
    "titleLocation": {
      "type": "string",
      "default": "image"
    },
    "taxonomy": {
      "type": "string",
      "default": "category"
    },
    "limit": {
      "type": "integer",
      "default": 12
    },
    "availableTaxonomies": {
      "type": "array",
      "default": [
        {
          "label": "Post Categories",
          "value": "category"
        }
      ]
    },
    "bodyTextOptions": {
      "type": "object",
      "default": {
        "disableBackgroundImage": false,
        "disableVerticalAlign": true
      }
    }
  },
  "example": {
    "attributes": {
      "listLayout": "column-3",
      "limit": 6
    },
    "innerBlocks": [
      {
        "name": "capitola/body-text",
        "attributes": {
          "eyebrow": "Cupidatat pariatur",
          "headline": "Nulla Minim Est Do",
          "cta": {
            "title": "Consequat",
            "link": {
              "url": "/"
            }
          },
          "cta2": {
            "title": "Velit amet",
            "link": {
              "url": "/"
            }
          }
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Veniam do ex ex est elit culpa consequat excepteur occaecat quis. Nostrud magna ullamco exercitation nisi aliqua labore magna eiusmod mollit dolor aute non consequat."
            }
          }
        ]
      }
    ],
    "viewportWidth": 1440
  },
  "providesContext": {
    "bodyTextOptions": "bodyTextOptions",
    "revealAnimation": "revealAnimation",
    "revealSection": "revealSection",
    "introAlign": "introAlign"
  },
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "style": "capitola-post-listing",
  "viewScript": [
    "capitola-listing-sidescroll",
    "capitola-animations"
  ]
}