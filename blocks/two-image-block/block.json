{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "capitola/two-image-block",
  "title": "Two Image Block",
  "textdomain": "capitola",
  "description": "Display two overlapping images paired with side content in a layered layout.",
  "category": "custom-blocks",
  "keywords": [
    "images",
    "layered",
    "collage",
    "two image"
  ],
  "supports": {
    "anchor": true,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": [
        "top",
        "bottom"
      ]
    },
    "html": false
  },
  "attributes": {
    "anchor": {
      "type": "string",
      "default": ""
    },
    "introAlign": {
      "type": "string",
      "default": "left"
    },
    "mediaWidth": {
      "type": "integer",
      "default": 50
    },
    "gridAspectRatio": {
      "type": "string",
      "default": "1"
    },
    "rearImage": {
      "type": "object",
      "default": {
        "id": 0,
        "source_url": ""
      }
    },
    "rearImagePosition": {
      "type": "string",
      "default": "top-left"
    },
    "rearImageHeight": {
      "type": "integer",
      "default": 13
    },
    "rearImageWidth": {
      "type": "integer",
      "default": 16
    },
    "rearImageFocalPoint": {
      "type": "string",
      "default": "50% 50%"
    },
    "rearImageRadius": {
      "type": "string",
      "default": "small"
    },
    "rearImageShowCaption": {
      "type": "boolean",
      "default": false
    },
    "rearImageCaption": {
      "type": "string",
      "default": ""
    },
    "frontImage": {
      "type": "object",
      "default": {
        "id": 0,
        "source_url": ""
      }
    },
    "frontImageHeight": {
      "type": "integer",
      "default": 10
    },
    "frontImageWidth": {
      "type": "integer",
      "default": 11
    },
    "frontImageFocalPoint": {
      "type": "string",
      "default": "50% 50%"
    },
    "frontImageRadius": {
      "type": "string",
      "default": "small"
    },
    "frontImageShowCaption": {
      "type": "boolean",
      "default": false
    },
    "frontImageCaption": {
      "type": "string",
      "default": ""
    },
    "verticalAlign": {
      "type": "string",
      "default": "center"
    },
    "colorTheme": {
      "type": "string",
      "default": false
    },
    "revealAnimation": {
      "type": "object",
      "default": {
        "animation": "",
        "section": "block"
      }
    },
    "bodyTextOptions": {
      "type": "object",
      "default": {
        "disableBackgroundImage": true,
        "disableVerticalAlign": true
      }
    }
  },
  "example": {
    "attributes": {
      "frontImage": {
        "source_url": "https://pd.w.org/2025/07/175687190064e5331.25489020-768x512.jpg"
      },
      "rearImage": {
        "source_url": "https://pd.w.org/2025/07/78368718f0804ea01.26512460-768x512.jpg"
      }
    },
    "innerBlocks": [
      {
        "name": "capitola/body-text",
        "attributes": {
          "eyebrow": "Cupidatat pariatur",
          "headline": "Nulla Minim Est Do",
          "cta": {
            "title": "Consequat",
            "link": {
              "url": "/"
            }
          },
          "cta2": {
            "title": "Velit amet",
            "link": {
              "url": "/"
            }
          }
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Veniam do ex ex est elit culpa consequat excepteur occaecat quis. Nostrud magna ullamco exercitation nisi aliqua labore magna eiusmod mollit dolor aute non consequat."
            }
          }
        ]
      }
    ],
    "viewportWidth": 1440
  },
  "providesContext": {
    "bodyTextOptions": "bodyTextOptions",
    "revealAnimation": "revealAnimation",
    "introAlign": "introAlign"
  },
  "viewScript": "capitola-animations",
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "style": "capitola-two-image-block"
}