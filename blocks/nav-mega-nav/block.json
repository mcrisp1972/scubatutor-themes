{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "capitola/nav-mega-nav",
  "title": "Mega Nav",
  "description": "",
  "category": "nav-blocks",
  "keywords": [
    "site",
    "header",
    "navigation"
  ],
  "parent": [
    "capitola/nav"
  ],
  "supports": {},
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "link": {
      "type": "object",
      "default": {}
    },
    "imageId": {
      "type": "integer",
      "default": 0
    },
    "headline": {
      "type": "string",
      "default": ""
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "linksPerColumn": {
      "type": "integer",
      "default": 5
    },
    "populationMethod": {
      "type": "string",
      "default": "manual"
    },
    "autoPopulatePostType": {
      "type": "string",
      "default": "page"
    }
  },
  "render": "file:./render.php",
  "style": "capitola-nav-mega-nav",
  "editorScript": "file:./index.js"
}