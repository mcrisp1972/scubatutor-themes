{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "capitola/sticky-images-section",
  "title": "Sticky Images Section",
  "textdomain": "capitola",
  "description": "Add one content section with an associated sticky image inside Sticky Images.",
  "category": "custom-blocks",
  "keywords": [
    "image",
    "sticky",
    "section",
    "side image"
  ],
  "supports": {
    "anchor": true,
    "html": false
  },
  "parent": [
    "capitola/sticky-images"
  ],
  "attributes": {
    "anchor": {
      "type": "string",
      "default": ""
    },
    "sideImage": {
      "type": "object",
      "default": {
        "id": 0,
        "source_url": ""
      }
    },
    "showCaption": {
      "type": "boolean",
      "default": false
    },
    "captionOverride": {
      "type": "string",
      "default": ""
    },
    "imageFocalPoint": {
      "type": "string",
      "default": "50% 50%"
    },
    "bodyTextOptions": {
      "type": "object",
      "default": {
        "disableBackgroundImage": true,
        "disableTextAlign": true,
        "disableVerticalAlign": true
      }
    },
    "introAlign": {
      "type": "string",
      "default": "left"
    }
  },
  "providesContext": {
    "bodyTextOptions": "bodyTextOptions",
    "introAlign": "introAlign"
  },
  "usesContext": [
    "showFullImage"
  ],
  "render": "file:./render.php",
  "editorScript": "file:./index.js"
}