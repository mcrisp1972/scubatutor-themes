{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "capitola/detailed-links-item",
  "title": "Detailed Link List Item",
  "textdomain": "capitola",
  "description": "Create one detailed link card item with image, title, and excerpt.",
  "category": "custom-blocks",
  "keywords": [
    "link item",
    "card",
    "featured link",
    "excerpt"
  ],
  "parent": [
    "capitola/detailed-links-list"
  ],
  "supports": {
    "anchor": false,
    "html": false
  },
  "attributes": {
    "postType": {
      "type": "string",
      "default": "post"
    },
    "postId": {
      "type": "integer",
      "default": 0
    },
    "linkImage": {
      "type": "object",
      "default": {
        "id": 0,
        "source_url": ""
      }
    },
    "linkTitle": {
      "type": "string",
      "default": ""
    },
    "linkExcerpt": {
      "type": "string",
      "default": ""
    }
  },
  "usesContext": [
    "showExcerpt",
    "showImage"
  ],
  "render": "file:./render.php",
  "editorScript": "file:./index.js"
}