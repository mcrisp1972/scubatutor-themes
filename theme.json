			"text": "var(--capitola-color-body)"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"right": "var(--wp--custom--spacing--gutter)",
				"left": "var(--wp--custom--spacing--gutter)",
				"top": "0",
				"bottom": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--custom--font-size--p-m)",
			"lineHeight": "var(--wp--custom--line-height--p)",
			"fontWeight": "var(--wp--custom--font-weight--normal)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"lineHeight": "var(--wp--custom--line-height--hl)",
					"fontWeight": "var(--wp--custom--font-weight--hl)"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"color": {
					"text": "var(--capitola-color-headline)"
				},
				"css": "&:not(:first-child) {margin-top: var(--wp--custom--spacing--open-content-headline);}"
			},
			"h1": {
				"typography": {
