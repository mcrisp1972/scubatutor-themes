		"custom": {
			"contentSize": "750px",
			"wideSize": "1250px",
			"contentSizePadded": "min(var(--wp--custom--content-size), calc(100% - (var(--wp--custom--spacing--gutter) * 2)))",
			"wideSizePadded": "min(var(--wp--custom--wide-size), calc(100% - (var(--wp--custom--spacing--gutter) * 2)))",
			"wideSizePadding": "max(var(--wp--custom--spacing--gutter), calc((100% - var(--wp--custom--wide-size)) / 2))",
			"wideSizeMargin": "max(var(--wp--custom--spacing--gutter), calc((100vw - var(--wp--custom--wide-size)) / 2))",
			"fluid": {
				"12-14": "clamp(0.75rem, 0.675rem + 0.25vw, 0.875rem)",
				"14-16": "clamp(0.875rem, 0.8rem + 0.25vw, 1rem)",
				"16-18": "clamp(1rem, 0.925rem + 0.25vw, 1.125rem)",
				"16-80": "clamp(1rem, -1.4rem + 8vw, 5rem)",
				"18-20": "clamp(1.125rem, 1.05rem + 0.25vw, 1.25rem)",
				"20-22": "clamp(1.25rem, 1.175rem + 0.25vw, 1.375rem)",
				"20-24": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)",
				"24-32": "clamp(1.5rem, 1.2rem + 1vw, 2rem)",
				"32-40": "clamp(2rem, 1.7rem + 1vw, 2.5rem)",
				"32-48": "clamp(2rem, 1.4rem + 2vw, 3rem)",
				"40-48": "clamp(2.5rem, 2.2rem + 1vw, 3rem)",
				"40-80": "clamp(2.5rem, 1rem + 5vw, 5rem)",
				"48-56": "clamp(3rem, 2.7rem + 1vw, 3.5rem)",
				"56-112": "clamp(3.5rem, 1.4rem + 7vw, 7rem)"
			},
			"opacity": {
				"solid": "#000000",
				"xdark": "#000000E6",
				"dark": "#00000080",
				"medium": "#00000066",
				"light": "#00000033"
			},
			"truncateLines": "4",
			"forms": {
				"field": {
					"background": "transparent",
					"borderColor": "var(--capitola-color-body)",
					"borderRadius": "2px",
					"borderWidth": "1px",
					"color": "var(--capitola-color-body)",
					"focusShadowColor": "var(--capitola-color-body)",
					"focusShadowSize": "0 0 0 1px",
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--custom--font-size--p-s)",
					"lineHeight": "1.5",
					"paddingBlock": "var(--wp--custom--spacing--xxsmall)",
					"paddingInline": "var(--wp--custom--spacing--xsmall)",
					"transition": "box-shadow 0.2s ease-in"
				},
				"radioCb": {
					"listGap": "var(--wp--custom--spacing--xsmall)",
					"inputSize": "18px",
					"label": {
						"color": "var(--capitola-color-body)",
						"letterSpacing": "normal",
						"fontWeight": "var(--wp--custom--font-weight--normal)",
						"fontSize": "0.9rem",
						"lineHeight": "1.5",
						"marginLeft": "var(--wp--custom--spacing--xsmall)"
					}
				},
				"label": {
					"color": "var(--capitola-color-body)",
					"fontWeight": "var(--wp--custom--font-weight--bold)",
					"fontSize": "0.75rem",
					"letterSpacing": "0.08rem",
					"lineHeight": "1.5"
				},
				"grid": {
					"vGap": "var(--wp--custom--spacing--small)",
					"hGap": "var(--wp--custom--spacing--small)"
				}
			},
			"fontWeight": {
				"normal": "400",
				"bold": "700",
				"hl": "700"
			},
			"fontSize": {
				"p-xs": "var(--wp--custom--fluid--12-14)",
				"p-s": "var(--wp--custom--fluid--14-16)",
				"p-m": "var(--wp--custom--fluid--16-18)",
				"p-l": "var(--wp--custom--fluid--18-20)",
				"p-xl": "var(--wp--custom--fluid--20-22)",
				"hl-xs": "var(--wp--custom--fluid--18-20)",
				"hl-s": "var(--wp--custom--fluid--20-24)",
				"hl-m": "var(--wp--custom--fluid--24-32)",
				"hl-l": "var(--wp--custom--fluid--32-40)",
				"hl-xl": "var(--wp--custom--fluid--40-48)",
				"hl-xxl": "var(--wp--custom--fluid--48-56)"
			},
			"lineHeight": {
				"p": "1.5",
				"hl": "1"
			},
			"buttons": {
				"font": {
					"family": "var(--wp--preset--font-family--primary)",
					"size": "var(--wp--custom--fluid--16-18)",
					"weight": "var(--wp--custom--font-weight--bold)"
				},
				"borderRadius": "3px",
				"padding": "var(--wp--custom--spacing--xsmall) var(--wp--custom--spacing--small)",
				"lineHeight": "1.15"
			},
			"spacing": {
				"xxlarge": "var(--wp--custom--fluid--56-112)",
				"xlarge": "var(--wp--custom--fluid--40-80)",
				"large": "var(--wp--custom--fluid--32-48)",
				"medium": "var(--wp--custom--fluid--24-32)",
				"small": "16px",
				"xsmall": "8px",
				"xxsmall": "4px",
				"openContent": "16px",
				"openContentHeadline": "var(--wp--custom--fluid--24-32)",
				"blockPadding": "var(--wp--custom--fluid--40-80)",
				"gutter": "var(--wp--custom--fluid--16-80)",
				"bodyEyebrowBottom": "var(--wp--custom--spacing--xsmall)",
				"bodyIntroTop": "var(--wp--custom--spacing--small)",
				"bodyCtasTop": "var(--wp--custom--spacing--small)",
				"blockSectionRowGap": "var(--wp--custom--fluid--32-48)",
				"blockSectionColumnGap": "var(--wp--custom--fluid--40-80)"
			},
			"transitions": {
				"default": "0.2s ease-in"
			}
		},
