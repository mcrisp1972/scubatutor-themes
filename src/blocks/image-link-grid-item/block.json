{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/image-link-grid-item",
	"title": "Image Link Grid Item",
	"textdomain": "capitola",
	"description": "Add one linked image card item inside an Image Link Grid.",
	"category": "custom-blocks",
	"keywords": [
		"image link",
		"grid item",
		"card",
		"featured link"
	],
	"supports": {
		"anchor": true,
		"html": false,
		"customCSS": false
	},
	"parent": [
		"capitola/image-link-grid"
	],
	"attributes": {
		"postType": {
			"type": "string",
			"default": "page"
		},
		"postId": {
			"type": "integer",
			"default": 0
		},
		"imageOverride": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"eyebrowOverride": {
			"type": "string",
			"default": ""
		},
		"titleOverride": {
			"type": "string",
			"default": ""
		},
		"excerptOverride": {
			"type": "string",
			"default": ""
		},
		"ctaOverride": {
			"type": "string",
			"default": ""
		},
		"imageOpacity": {
			"type": "number",
			"default": 0.5
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}