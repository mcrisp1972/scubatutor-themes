{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/icon-item",
	"title": "Icon Item",
	"textdomain": "capitola",
	"description": "Add a single icon with title and caption inside an Icon Grid.",
	"category": "custom-blocks",
	"keywords": [
		"icon",
		"feature",
		"icon item",
		"caption"
	],
	"supports": {
		"html": false,
		"customCSS": false
	},
	"parent": [
		"capitola/icon-grid"
	],
	"attributes": {
		"icon": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}