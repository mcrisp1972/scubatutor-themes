{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/full-width-slider",
	"title": "Full Width Slider",
	"textdomain": "capitola",
	"description": "Display a full-width image slider with captions, links, and optional intro content.",
	"category": "custom-blocks",
	"keywords": [
		"slider",
		"carousel",
		"gallery",
		"full width"
	],
	"supports": {
		"anchor": true,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			],
			"padding": [
				"top",
				"bottom"
			]
		}
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"introAlign": {
			"type": "string",
			"default": "left"
		},
		"colorTheme": {
			"type": "string",
			"default": false
		},
		"revealAnimation": {
			"type": "string",
			"default": "0"
		},
		"revealSection": {
			"type": "string",
			"default": "body"
		},
		"allowRevealSectionSelect": {
			"type": "boolean",
			"default": true
		},
		"transition": {
			"type": "string",
			"default": "slide"
		},
		"navigation": {
			"type": "string",
			"default": "arrows"
		},
		"aspectRatio": {
			"type": "string",
			"default": "16-9"
		},
		"sliderRadius": {
			"type": "string",
			"default": "none"
		},
		"stickySlider": {
			"type": "boolean",
			"default": false
		},
		"autoplay": {
			"type": "boolean",
			"default": false
		},
		"slides": {
			"type": "array",
			"default": [
				{
					"image": {
						"id": 0,
						"source_url": ""
					},
					"caption": "",
					"link": {}
				}
			]
		},
		"bodyTextOptions": {
			"type": "object",
			"default": {
				"disableBackgroundImage": true
			}
		}
	},
	"example": {
		"attributes": {
			"slides": [
				{
					"image": {
						"source_url": "https://pd.w.org/2023/12/46665733547928280.70690426-1536x1152.jpg"
					},
					"caption": "Voluptate aliquip tempor ad sunt ullamco cillum aute Lorem pariatur incididunt ut tempor eiusmod aliquip.",
					"link": false,
					"ctaLabel": "Do tempor"
				}
			]
		},
		"innerBlocks": [
			{
				"name": "capitola/body-text",
				"attributes": {
					"eyebrow": "Cupidatat pariatur",
					"headline": "Nulla Minim Est Do",
					"cta": {
						"title": "Consequat",
						"link": {
							"url": "/"
						}
					},
					"cta2": {
						"title": "Velit amet",
						"link": {
							"url": "/"
						}
					}
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Veniam do ex ex est elit culpa consequat excepteur occaecat quis. Nostrud magna ullamco exercitation nisi aliqua labore magna eiusmod mollit dolor aute non consequat."
						}
					}
				]
			}
		],
		"viewportWidth": 1440
	},
	"providesContext": {
		"bodyTextOptions": "bodyTextOptions",
		"revealAnimation": "revealAnimation",
		"revealSection": "revealSection",
		"introAlign": "introAlign"
	},
	"render": "file:./render.php",
	"style": [
		"swiper",
		"capitola-full-width-slider"
	],
	"viewScript": [
		"file:./view.js",
		"capitola-animations"
	],
	"editorScript": "file:./index.js"
}