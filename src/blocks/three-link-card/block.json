{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cwps/three-link-card",
	"title": "Three Link Card",
	"description": "",
	"category": "cwps-custom-blocks",
	"keywords": [],
	"supports": {
		"lock": false,
		"inserter": false
	},
	"parent": ["cwps/three-link-cards-grid"],
	"attributes": {
		"postType": {
			"type": "string",
			"default": "page"
		},
		"postId": {
			"type": "integer",
			"default": 0
		},
		"image": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"imageRadius": {
			"type": "string",
			"default": "small"
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
