{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/three-link-card",
	"title": "Three Link Card",
	"textdomain": "capitola",
	"description": "Add one linked card item with image and title inside a three-card layout.",
	"category": "custom-blocks",
	"keywords": [
		"card",
		"link",
		"image card",
		"featured link"
	],
	"supports": {
		"lock": false,
		"inserter": false,
		"html": false
	},
	"parent": [
		"capitola/three-link-cards-grid"
	],
	"attributes": {
		"postType": {
			"type": "string",
			"default": "page"
		},
		"postId": {
			"type": "integer",
			"default": 0
		},
		"image": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"imageRadius": {
			"type": "string",
			"default": "small"
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}