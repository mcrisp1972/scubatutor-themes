{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/fixed-background",
	"title": "Fixed Background",
	"textdomain": "capitola",
	"description": "Layer content over a fixed background image.",
	"category": "custom-blocks",
	"keywords": [
		"fixed background",
		"parallax",
		"background image",
		"section"
	],
	"supports": {
		"anchor": true,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		},
		"html": false,
		"customCSS": false
	},
	"attributes": {
		"introAlign": {
			"type": "string",
			"default": "left"
		},
		"mobileImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"tabletImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"desktopImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"colorThemeBody": {
			"type": "boolean",
			"default": false
		},
		"imageOpacity": {
			"type": "number",
			"default": 0.5
		},
		"introRadius": {
			"type": "string",
			"default": "small"
		},
		"colorTheme": {
			"type": "string",
			"default": false
		},
		"revealAnimation": {
			"type": "object",
			"default": {
				"animation": "",
				"section": "body"
			}
		},
		"bodyTextOptions": {
			"type": "object",
			"default": {
				"disableBackgroundImage": true,
				"disableVerticalAlign": true
			}
		}
	},
	"example": {
		"attributes": {
			"desktopImage": {
				"source_url": "https://pd.w.org/2022/11/471636e75a59f2df1.27699711-2048x1536.jpg"
			}
		},
		"innerBlocks": [
			{
				"name": "capitola/body-text",
				"attributes": {
					"eyebrow": "Cupidatat pariatur",
					"headline": "Nulla Minim Est Do",
					"cta": {
						"title": "Consequat",
						"link": {
							"url": "/"
						}
					},
					"cta2": {
						"title": "Velit amet",
						"link": {
							"url": "/"
						}
					}
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Veniam do ex ex est elit culpa consequat excepteur occaecat quis. Nostrud magna ullamco exercitation nisi aliqua labore magna eiusmod mollit dolor aute non consequat."
						}
					}
				]
			}
		],
		"viewportWidth": 1440
	},
	"providesContext": {
		"capitola/bodyTextOptions": "bodyTextOptions",
		"capitola/revealAnimation": "revealAnimation",
		"capitola/introAlign": "introAlign"
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "capitola-fixed-background",
	"editorStyle": "capitola-fixed-background-editor",
	"viewScript": [
		"capitola-animations",
		"file:./view.js"
	]
}