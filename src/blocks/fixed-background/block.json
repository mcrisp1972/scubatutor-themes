{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cwps/fixed-background",
	"title": "Fixed Background",
	"description": "",
	"category": "cwps-custom-blocks",
	"keywords": ["product"],
	"supports": {
		"anchor": true,
		"spacing": {
			"margin": ["top", "bottom"]
		}
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"introAlign": {
			"type": "string",
			"default": "left"
		},
		"mobileImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"tabletImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"desktopImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"colorThemeBody": {
			"type": "boolean",
			"default": false
		},
		"imageOpacity": {
			"type": "number",
			"default": 0.5
		},
		"introRadius": {
			"type": "string",
			"default": "small"
		},
		"colorTheme": {
			"type": "string",
			"default": false
		},
		"revealAnimation": {
			"type": "string",
			"default": "0"
		},
		"revealSection": {
			"type": "string",
			"default": "body"
		},
		"allowRevealSectionSelect": {
			"type": "boolean",
			"default": false
		},
		"bodyTextOptions": {
			"type": "object",
			"default": {
				"disableBackgroundImage": true,
				"disableVerticalAlign": true
			}
		}
	},
	"example": {
		"attributes": {
			"desktopImage": {
				"source_url": "https://pd.w.org/2022/11/471636e75a59f2df1.27699711-2048x1536.jpg"
			}
		},
		"innerBlocks": [
			{
				"name": "cwps/body-text",
				"attributes": {
					"eyebrow": "Cupidatat pariatur",
					"headline": "Nulla Minim Est Do",
					"cta": {
						"title": "Consequat",
						"link": { "url": "/" }
					},
					"cta2": {
						"title": "Velit amet",
						"link": { "url": "/" }
					}
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Veniam do ex ex est elit culpa consequat excepteur occaecat quis. Nostrud magna ullamco exercitation nisi aliqua labore magna eiusmod mollit dolor aute non consequat."
						}
					}
				]
			}
		],
		"viewportWidth": 1440
	},
	"providesContext": {
		"bodyTextOptions": "bodyTextOptions",
		"revealAnimation": "revealAnimation",
		"revealSection": "revealSection",
		"introAlign": "introAlign"
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "cwps-fixedBackground",
	"editorStyle": "cwps-fixedBackground-editor",
	"viewScript": ["cwps-animations", "file:./view.js"]
}
