{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cwps/iframe-wrapper",
	"title": "iFrame wrapper",
	"description": "",
	"category": "cwps-custom-blocks",
	"keywords": [],
	"supports": {
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": {
			"margin": ["top", "bottom"]
		}
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"align": {
			"type": "string",
			"default": ""
		},
		"aspectRatio": {
			"type": "string",
			"default": "16-9"
		},
		"iframeHtml": {
			"type": "string",
			"default": ""
		}
	},
	"example": {},
	"render": "file:./render.php",
	"style": "cwps-iframeWrapper",
	"editorStyle": "cwps-iframeWrapperEdit",
	"editorScript": "file:./index.js"
}
