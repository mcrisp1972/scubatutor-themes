{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cwps/sticky-images-section",
	"title": "Sticky Images Section",
	"description": "",
	"category": "cwps-custom-blocks",
	"keywords": ["image", "sticky"],
	"supports": {
		"anchor": true
	},
	"parent": ["cwps/sticky-images"],
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"sideImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"showCaption": {
			"type": "boolean",
			"default": false
		},
		"captionOverride": {
			"type": "string",
			"default": ""
		},
		"imageCropPosition": {
			"type": "string",
			"default": "center center"
		},
		"bodyTextOptions": {
			"type": "object",
			"default": {
				"disableBackgroundImage": true,
				"disableTextAlign": true,
				"disableVerticalAlign": true
			}
		},
		"introAlign": {
			"type": "string",
			"default": "left"
		}
	},
	"providesContext": {
		"bodyTextOptions": "bodyTextOptions",
		"introAlign": "introAlign"
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
