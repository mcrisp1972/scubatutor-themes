{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cwps/detailed-links-item",
	"title": "Detailed Link List Item",
	"description": "",
	"category": "cwps-custom-blocks",
	"parent": ["cwps/detailed-links-list"],
	"supports": {
		"anchor": false
	},
	"attributes": {
		"postType": {
			"type": "string",
			"default": "post"
		},
		"postId": {
			"type": "integer",
			"default": 0
		},
		"linkImage": {
			"type": "object",
			"default": {
				"id": 0,
				"source_url": ""
			}
		},
		"linkTitle": {
			"type": "string",
			"default": ""
		},
		"linkExcerpt": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": ["showExcerpt", "showImage"],
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
