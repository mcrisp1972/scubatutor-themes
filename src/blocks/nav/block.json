{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "capitola/nav",
	"title": "Site Nav Header",
	"textdomain": "capitola",
	"description": "Display the site header navigation with logo, utility links, and optional icons.",
	"category": "nav-blocks",
	"keywords": [
		"nav",
		"header",
		"navigation",
		"menu"
	],
	"supports": {
		"multiple": false,
		"interactivity": true
	},
	"attributes": {
		"logo": {
			"type": "integer",
			"default": 0
		},
		"useLogoColor": {
			"type": "boolean",
			"default": false
		},
		"showAccountIcon": {
			"type": "boolean",
			"default": true
		},
		"showCartIcon": {
			"type": "boolean",
			"default": true
		},
		"showPhoneLink": {
			"type": "boolean",
			"default": true
		},
		"utilityLinks": {
			"type": "array",
			"default": []
		},
		"stickyStyle": {
			"type": "string",
			"default": "--reveal-down"
		},
		"dropdownSpeed": {
			"type": "number",
			"default": "0.2"
		},
		"isExample": {
			"type": "boolean",
			"default": false
		}
	},
	"example": {
		"attributes": {
			"isExample": true
		},
		"viewportWidth": 1440
	},
	"render": "file:./render.php",
	"style": "capitola-nav",
	"editorStyle": "capitola-nav-editor",
	"viewScriptModule": "file:./view.js",
	"editorScript": "file:./index.js"
}