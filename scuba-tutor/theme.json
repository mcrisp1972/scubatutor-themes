	"styles": {
		"color": {
			"background": "var(--capitola-color-background)",
			"text": "var(--capitola-color-body)"
		},
		"spacing": {
			"padding": {
				"right": "var(--capitola-gutter)",
				"left": "var(--capitola-gutter)",
				"top": "0",
				"bottom": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--capitola-p-fontSize)",
			"lineHeight": "var(--capitola-p-lineHeight)",
			"fontWeight": "var(--capitola-p-fontWeight)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"lineHeight": "var(--capitola-hl-lineHeight)",
					"fontWeight": "var(--capitola-hl-fontWeight)"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"color": {
					"text": "var(--capitola-color-headline)"
				},
				"css": "&:not(:first-child) {margin-top: var(--capitola-open-headline-spacing);}"
			},
			"h1": {
				"typography": {
					"fontSize": "var(--capitola-hl-xl-fontSize)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--capitola-hl-l-fontSize)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--capitola-hl-m-fontSize)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--capitola-hl-s-fontSize)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--capitola-hl-xs-fontSize)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--capitola-hl-xs-fontSize)"
				}
			},
			"link": {
				"color": {
					"text": "var(--capitola-color-link)"
				},
				"typography": {
					"fontWeight": "600",
					"textDecoration": "underline"
				}
			}
		},
		"blocks": {
			"core/buttons": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--small)"
				},
				"css": "&:not(:first-child) {margin-top: var(--capitola-open-content-spacing);}"
			},
			"core/columns": {
				"spacing": {
					"margin": {
						"top": "var(--capitola-spacing-small)",
						"bottom": "0"
					},
					"blockGap": "var(--wp--preset--spacing--medium)"
				},
				"color": {
					"background": "var(--capitola-color-background)"
				}
			},
			"core/column": {
				"color": {
					"background": "var(--capitola-color-background)"
				}
			},
			"core/embed": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"css": "&:not(:first-child){margin-top: var(--capitola-open-content-spacing);"
			},
			"core/gallery": {
				"css": "--wp--style--gallery-gap-default: var(--wp--preset--spacing--xxsmall); &:not(:first-child) {margin-top: var(--capitola-open-content-spacing);}"
			},
			"core/group": {
				"color": {
					"background": "var(--capitola-color-background)"
				}
			},
			"core/heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)"
				},
				"css": "&:not(:first-child){margin-top: var(--capitola-open-headline-spacing);"
			},
			"core/image": {
				"css": "&:not(:first-child) {margin-top: var(--capitola-open-content-spacing);"
			},
			"core/list": {
				"color": {
					"text": "var(--capitola-color-body)"
				},
				"css": "&:not(:first-child) {margin-top: var(--capitola-open-content-spacing);}"
			},
			"core/media-text": {
				"css": "&:not(:first-child) {margin-top: var(--capitola-open-content-spacing);}"
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"color": {
					"text": "var(--capitola-color-body)"
				},
				"css": "&:not(:first-child) {margin-top: var(--capitola-open-content-spacing);"
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var(--capitola-p-l-fontSize)",
					"lineHeight": "1.5"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var(--capitola-p-s-fontSize)",
							"fontStyle": "italic"
						},
						"spacing": {
							"margin": {
								"top": "var(--capitola-open-content-spacing)",
								"bottom": "0"
							}
						}
					}
				}
			},
			"core/quote": {
				"spacing": {
					"padding": {
						"left": "var(--capitola-spacing-small)"
					}
				},
				"border": {
					"style": "solid",
					"width": "0 0 0 2px",
					"color": "var(--capitola-color-accent)"
				},
				"css": "&:not(:first-child) {margin-top: var(--capitola-open-content-spacing);}}"
			},
			"core/video": {
				"css": "&:not(:first-child) {margin-top: var(--capitola-open-content-spacing);"
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}