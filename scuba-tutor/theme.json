{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "var(--capitola-contentSize)",
			"wideSize": "var(--capitola-wideSize)",
			"allowCustomContentAndWideSize": false
		},
		"spacing": {
			"blockGap": null,
			"units": [
				"px",
				"%"
			],
			"defaultSpacingSizes": false,
			"customSpacingSize": false,
			"margin": true,
			"padding": true,
			"spacingSizes": [
				{
					"size": "var(--capitola-spacing-xxsmall)",
					"slug": "xxsmall",
					"name": "XX Small"
				},
				{
					"size": "var(--capitola-spacing-xsmall)",
					"slug": "xsmall",
					"name": "X Small"
				},
				{
					"size": "var(--capitola-spacing-small)",
					"slug": "small",
					"name": "Small"
				},
				{
					"size": "var(--capitola-spacing-medium)",
					"slug": "medium",
					"name": "Medium"
				},
				{
					"size": "var(--capitola-spacing-large)",
					"slug": "large",
					"name": "Large"
				},
				{
					"size": "var(--capitola-spacing-xlarge)",
					"slug": "xlarge",
					"name": "X Large"
				},
				{
					"size": "var(--capitola-spacing-xxlarge)",
					"slug": "xxlarge",
					"name": "XX Large"
				}
			]
		},
		"color": {
			"background": false,
			"text": false,
			"button": false,
			"heading": false,
			"gradients": [],
			"duotone": [],
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "ocean-depth",
					"color": "#0D698B",
					"name": "Ocean Depth"
				},
				{
					"slug": "firebrick",
					"color": "#D8382A",
					"name": "Firebrick"
				},
				{
					"slug": "vanilla-lace",
					"color": "#F2F1E8",
					"name": "Vanilla Lace"
				}
			]
		},
		"typography": {
			"dropCap": false,
			"letterSpacing": false,
			"customFontSize": false,
			"textTransform": false,
			"textDecoration": false,
			"fontSizes": [],
			"defaultFontSizes": false,
			"fontStyle": false,
			"fontWeight": false,
			"fontFamilies": [
				{
					"name": "Open Sans",
					"slug": "primary",
					"fontFamily": "'Open Sans', helvetica, arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Open Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-v44-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "Open Sans",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-v44-latin-700.woff2"
							]
						},
						{
							"fontFamily": "Open Sans",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-v44-latin-italic.woff2"
							]
						},
						{
							"fontFamily": "Open Sans",
							"fontWeight": "700",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-v44-latin-700italic.woff2"
							]
						}
					]
				},
				{
					"name": "Open Sans",
					"slug": "heading",
					"fontFamily": "'Open Sans', helvetica, arial, sans-serif"
				}
			]
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}