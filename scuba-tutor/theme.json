{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "ocean-depth",
					"color": "#0D698B",
					"name": "Ocean Depth"
				},
				{
					"slug": "firebrick",
					"color": "#D8382A",
					"name": "Firebrick"
				},
				{
					"slug": "vanilla-lace",
					"color": "#F2F1E8",
					"name": "Vanilla Lace"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Open Sans",
					"slug": "primary",
					"fontFamily": "'Open Sans', helvetica, arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Open Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-v44-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "Open Sans",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-v44-latin-700.woff2"
							]
						},
						{
							"fontFamily": "Open Sans",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-v44-latin-italic.woff2"
							]
						},
						{
							"fontFamily": "Open Sans",
							"fontWeight": "700",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-v44-latin-700italic.woff2"
							]
						}
					]
				},
				{
					"name": "Open Sans",
					"slug": "heading",
					"fontFamily": "'Open Sans', helvetica, arial, sans-serif"
				}
			]
		},
		"custom": {
			"contentSize": "1000px",
			"wideSize": "1000px"
		}
	}
}